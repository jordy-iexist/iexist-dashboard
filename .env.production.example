# Production compose variables — copy to `.env` on the server next to docker-compose.prod.yml
# Used by: docker compose -f docker-compose.prod.yml up -d --build

# Root domain; Caddy serves app.<DOMAIN> (frontend) and api.<DOMAIN> (backend)
DOMAIN=iexist.nl

# Spatiegescheiden (GEEN komma's) IP's of CIDR-ranges die toegang hebben tot
# app.<DOMAIN> (het dashboard). api.<DOMAIN> blijft publiek (nodig voor
# blog-afbeeldingen via signed URLs). Achterhaal je eigen IP met: curl ifconfig.me
# Eén IP:    91.215.151.210
# Meerdere:  "91.215.151.210 84.22.33.44"   <-- quotes verplicht bij meerdere
# Range:     91.215.151.0/24
# Let op: bij een dynamisch (thuis-)IP moet je dit bijwerken en Caddy herladen.
ALLOWED_IPS=91.215.151.210

# Postgres password for the db container (generate: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Baked into the frontend bundle at build time (NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOTE: backend secrets (JWT_SECRET_KEY, STORAGE_SIGNING_SECRET, OPENAI_API_KEY, ...)
# go in backend/.env — see backend/.env.example and DEPLOY.md
