DATABASE_URL=postgresql+psycopg://csv_blog_generator:csv_blog_generator@db:5432/csv_blog_generator
POSTGRES_DB=csv_blog_generator
POSTGRES_USER=csv_blog_generator
POSTGRES_PASSWORD=csv_blog_generator

JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=10080
STORAGE_SIGNING_SECRET=change-me-storage-secret

# Gebruikers stellen hun eigen OpenAI API key in via /dashboard/settings.
# Deze backend gebruikt geen gedeelde OpenAI runtime key meer.
OPENAI_API_KEY=
REDIS_URL=redis://redis:6379/0
WORKER_CONCURRENCY=3
CELERY_LOG_LEVEL=info
CELERY_QUEUES=default,blog_generation,image_generation

MEDIA_ROOT=/app/media
MEDIA_BASE_URL=http://localhost:8000

CORS_ALLOWED_ORIGINS=http://localhost:3000
WORDPRESS_CREDENTIALS_KEY=your_fernet_key
WORDPRESS_REQUEST_TIMEOUT_SECONDS=20
BLOG_IMAGE_MAX_SIZE_BYTES=5242880
BLOG_IMAGE_SIGNED_URL_TTL_SECONDS=3600
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_RESPONSES_MODEL=gpt-5
OPENAI_IMAGE_SIZE=1024x1024
SERPAPI_API_KEY=
SERPAPI_TIMEOUT_SECONDS=20
SERPAPI_RESULTS_DEPTH=20
SERPAPI_MAX_REQUESTS_PER_SCAN=25
SEO_META_MAX_PAGES_PER_RUN=50
SEO_META_HTTP_TIMEOUT_SECONDS=15
SEO_META_CRAWL_MAX_DEPTH=2
SEO_META_CRAWL_MAX_PAGES=200
SEO_META_TITLE_MAX_CHARS=60
SEO_META_DESCRIPTION_MAX_CHARS=160
SEO_META_OPENAI_MODEL=gpt-5.2
OPENAI_BLOG_MODEL=gpt-4o-mini
