DATABASE_URL=postgresql+psycopg://csv_blog_generator:csv_blog_generator@db:5432/csv_blog_generator
POSTGRES_DB=csv_blog_generator
POSTGRES_USER=csv_blog_generator
POSTGRES_PASSWORD=csv_blog_generator

# VERPLICHT: genereer unieke waarden, anders weigert de app te starten.
#   openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440
STORAGE_SIGNING_SECRET=change-me-storage-secret

# Gebruikers stellen hun eigen OpenAI API key in via /dashboard/settings.
# Deze backend gebruikt geen gedeelde OpenAI runtime key meer.
OPENAI_API_KEY=
REDIS_URL=redis://redis:6379/0
WORKER_CONCURRENCY=3
CELERY_LOG_LEVEL=info
CELERY_QUEUES=default,blog_generation,image_generation,audit

MEDIA_ROOT=/app/media
MEDIA_BASE_URL=http://localhost:8000

CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.blogdrip.com
WORDPRESS_CREDENTIALS_KEY=your_fernet_key
WORDPRESS_REQUEST_TIMEOUT_SECONDS=20
BLOG_IMAGE_MAX_SIZE_BYTES=5242880
BLOG_IMAGE_SIGNED_URL_TTL_SECONDS=3600
SERPAPI_API_KEY=
SERPAPI_TIMEOUT_SECONDS=20
SERPAPI_RESULTS_DEPTH=20
SERPAPI_MAX_REQUESTS_PER_SCAN=25
SEO_META_MAX_PAGES_PER_RUN=50
SEO_META_HTTP_TIMEOUT_SECONDS=15
SEO_META_CRAWL_MAX_DEPTH=2
SEO_META_CRAWL_MAX_PAGES=200
SEO_META_TITLE_MAX_CHARS=60
SEO_META_DESCRIPTION_MAX_CHARS=160
# Model defaults (OPENAI_BLOG_MODEL, OPENAI_IMAGE_MODEL, OPENAI_IMAGE_SIZE, ...) staan in app/core/config.py. Alleen hier zetten om ze te overschrijven.

# Livegang checklist (fase 1 scan)
PAGESPEED_API_KEY=
LAUNCH_SCAN_OPENAI_MODEL=gpt-5.2
# Livegang fase 3: AI-analyse per geselecteerde pagina
LAUNCH_CONTENT_MAX_PAGES_PER_ANALYSIS=25
LAUNCH_CONTENT_AI_CONCURRENCY=3
LAUNCH_CONTENT_MAX_IMAGES_PER_PAGE=6

# Monday.com (livegang: punten doorzetten). Borden komen in de map MONDAY_FOLDER_NAME.
MONDAY_API_TOKEN=
MONDAY_FOLDER_NAME=Website checklist scan
# MONDAY_FOLDER_ID=        # optioneel: vaste map-id i.p.v. zoeken op naam
# DASHBOARD_PUBLIC_URL=    # optioneel: link terug naar het dashboard in Monday

# Ahrefs API v3 (livegang: verkeer, backlinks en zoekwoorden per URL). Circa 7.000 units per scan.
AHREFS_API_KEY=
# AHREFS_COUNTRY=nl
# AHREFS_TOP_PAGES_LIMIT=200          # rijen per request (Standard: max 250)
# AHREFS_BACKLINK_PAGES_LIMIT=200
# AHREFS_BROKEN_BACKLINKS_LIMIT=100
# AHREFS_SNAPSHOT_TTL_DAYS=7          # herscan binnen deze termijn hergebruikt de data
# AHREFS_VALUE_MIN_TRAFFIC=50
# AHREFS_VALUE_MIN_REFDOMAINS=5
# AHREFS_KEYWORD_MAX_POSITION=20
